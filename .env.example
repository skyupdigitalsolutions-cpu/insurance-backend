NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=0
MONGODB_URI=mongodb://localhost:27017/insurance?directConnection=true
REDIS_URL=redis://localhost:6379
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-characters
OTP_SECRET=change-me-to-another-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
SMS_PROVIDER=console
# Optional, development only: set to a 6-digit code (e.g. 123456) to always use that OTP.
# Leave unset to get a random OTP, printed in the server terminal.
# OTP_FIXED_CODE=123456
RATE_LIMIT_ENABLED=true
API_DOCS_ENABLED=true
SEED_PASSWORD=Demo@1234

# Customer documents (KYC). "local" stores files in UPLOADS_DIR; cloud storage is added before production.
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=10
FILE_URL_SECRET=change-me-to-a-third-long-random-string-of-48-chars
FILE_URL_TTL_SEC=900

# Public address of this API (used in payment links). On a phone use your laptop IP, e.g. http://192.168.1.20:4000
PUBLIC_BASE_URL=http://localhost:4000
# Payments: "mock" = practice checkout page, no real money. "razorpay" needs the three keys below
# (Razorpay Dashboard -> Account & Settings -> API Keys / Webhooks; use Test Mode keys first).
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_LINK_EXPIRY_HOURS=72
QUOTE_VALIDITY_DAYS=30